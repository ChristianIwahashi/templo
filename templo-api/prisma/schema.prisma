// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ALUNO
  GESTOR
  PROFESSOR
}

model Usuario {
  idUsuario Int      @id @default(autoincrement())
  nome      String   @db.VarChar(100)
  email     String   @db.VarChar(100)
  senha     String   @db.VarChar(255)
  telefone  String   @db.VarChar(15)
  ativo     Boolean  @default(true)
  papel     Papel

  gestor    Gestor?
  aluno     Aluno?
  professor Professor?

  notasCriadas            Nota[]        @relation("NotaCriadaPor")
  notasAtualizadas        Nota[]        @relation("NotaAtualizadaPor")
  frequenciasCriadas      Frequencia[]  @relation("FrequenciaCriadaPor")
  frequenciasAtualizadas  Frequencia[]  @relation("FrequenciaAtualizadaPor")
  avisoAulasCriados     AvisoAula[] @relation("AvisoAulaCriadaPor")
  avisoAulasAtualizados AvisoAula[] @relation("AvisoAulaAtualizadaPor")
  materialDidaticosCriados     MaterialDidatico[] @relation("MaterialDidaticoCriadaPor")
  materialDidaticosAtualizados MaterialDidatico[] @relation("MaterialDidaticoAtualizadaPor")


  @@map("usuarios")
}

model Gestor {
  idUsuario Int      @id
  usuario   Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  alunosMatriculados       Aluno[]                @relation("GestorParaAluno")
  professoresMatriculados  Professor[]            @relation("GestorParaProfessor")
  mensalidades             Mensalidade[]          @relation("GestorParaMensalidade")
  conteudosInformativos    ConteudoInformativo[]  @relation("GestorParaConteudo")
  avisosEventos            AvisoEvento[]          @relation("GestorParaAvisoEvento")

  @@map("gestores")
}

model Aluno {
  idUsuario      Int      @id
  usuario        Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  dataNascimento DateTime @db.Date

  idGestor       Int
  gestor         Gestor @relation("GestorParaAluno", fields: [idGestor], references: [idUsuario])

  idTurma        Int?
  turma          Turma?  @relation("TurmaParaAluno", fields: [idTurma], references: [idTurma])

  mensalidades  Mensalidade[] @relation("AlunoParaMensalidade")
  notas         Nota[]        @relation("AlunoParaNota")
  frequencias   Frequencia[]  @relation("AlunoParaFrequencia")
  materiais     AlunoMaterialDidatico[]

  @@map("alunos")
}

model Professor {
  idUsuario Int      @id
  usuario   Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  idGestor  Int
  gestor    Gestor   @relation("GestorParaProfessor", fields: [idGestor], references: [idUsuario])

  turmas      Turma[]             @relation("ProfessorParaTurma")
  notas       Nota[]              @relation("ProfessorParaNota")
  frequencias Frequencia[]        @relation("ProfessorParaFrequencia")
  avisosAula  AvisoAula[]         @relation("ProfessorParaAvisoAula")
  materiais   MaterialDidatico[]  @relation("ProfessorParaMaterial")

  @@map("professores")
}

model Turma {
  idTurma      Int      @id @default(autoincrement())

  idProfessor  Int
  professor    Professor   @relation("ProfessorParaTurma", fields: [idProfessor], references: [idUsuario])

  alunos            Aluno[] @relation("TurmaParaAluno")
  avisosAula        AvisoAula[]  @relation("TurmaParaAvisoAula")
  materiaisBaixados TurmaMaterialDidatico[]

  @@map("turmas")
}

model Mensalidade {
  idMensalidade   Int      @id @default(autoincrement())
  mes             String   @db.VarChar(20)
  valor           Int
  dataVencimento  DateTime @db.Date
  statusPagamento String   @db.VarChar(50)

  idGestor        Int
  gestor          Gestor   @relation("GestorParaMensalidade", fields: [idGestor], references: [idUsuario])

  idAluno        Int
  aluno          Aluno   @relation("AlunoParaMensalidade", fields: [idAluno], references: [idUsuario])

  @@map("mensalidades")
}

model Nota {
  idNota        Int         @id @default(autoincrement())
  valor         Float
  tipo          String
  data          DateTime    @db.Date

  idProfessor   Int
  professor     Professor   @relation("ProfessorParaNota", fields: [idProfessor], references: [idUsuario])

  idAluno       Int
  aluno         Aluno   @relation("AlunoParaNota", fields: [idAluno], references: [idUsuario])

  criadoPorId     Int?
  criadoPor       Usuario?  @relation("NotaCriadaPor", fields: [criadoPorId], references: [idUsuario], onDelete: SetNull, map: "fk_nota_criado_por")

  atualizadoPorId Int?
  atualizadoPor   Usuario?  @relation("NotaAtualizadaPor", fields: [atualizadoPorId], references: [idUsuario], onDelete: SetNull, map: "fk_nota_atualizado_por")

  @@map("notas")
}

model Frequencia {
  idFrequencia  Int         @id @default(autoincrement())
  dataAula      DateTime    @db.Date
  presenca      Boolean

  idProfessor   Int
  professor     Professor   @relation("ProfessorParaFrequencia", fields: [idProfessor], references: [idUsuario])

  idAluno       Int
  aluno         Aluno   @relation("AlunoParaFrequencia", fields: [idAluno], references: [idUsuario])

  criadoPorId     Int?
  criadoPor       Usuario?  @relation("FrequenciaCriadaPor", fields: [criadoPorId], references: [idUsuario], onDelete: SetNull, map: "fk_frequencia_criado_por")

  atualizadoPorId Int?
  atualizadoPor   Usuario?  @relation("FrequenciaAtualizadaPor", fields: [atualizadoPorId], references: [idUsuario], onDelete: SetNull, map: "fk_frequencia_atualizado_por")

  @@map("frequencias")
}

model AvisoAula {
  idAvisoAula   Int       @id @default(autoincrement())
  titulo        String    @db.VarChar(255)
  dataPostagem  DateTime  @default(now())
  imagemUrl     String?   @db.VarChar(255)

  idProfessor   Int
  professor     Professor @relation("ProfessorParaAvisoAula", fields: [idProfessor], references: [idUsuario])

  idTurma       Int
  turma         Turma @relation("TurmaParaAvisoAula", fields: [idTurma], references: [idTurma])

  criadoPorId     Int?
  criadoPor       Usuario?  @relation("AvisoAulaCriadaPor", fields: [criadoPorId], references: [idUsuario], onDelete: SetNull, map: "fk_aviso_aula_criado_por")

  atualizadoPorId Int?
  atualizadoPor   Usuario?  @relation("AvisoAulaAtualizadaPor", fields: [atualizadoPorId], references: [idUsuario], onDelete: SetNull, map: "fk_aviso_aula_atualizado_por")


  @@map("avisos_aulas")
}

model MaterialDidatico {
  idMaterial  Int     @id @default(autoincrement())
  titulo      String  @db.VarChar(255)
  descricao   String  @db.Text
  arquivoUrl  String  @db.VarChar(255)
  dataPostagem DateTime @default(now())

  idProfessor   Int
  professor     Professor @relation("ProfessorParaMaterial", fields: [idProfessor], references: [idUsuario])

  turmasVinculadas  TurmaMaterialDidatico[]
  alunosVinculados  AlunoMaterialDidatico[]
  
  criadoPorId     Int?
  criadoPor       Usuario?  @relation("MaterialDidaticoCriadaPor", fields: [criadoPorId], references: [idUsuario], onDelete: SetNull, map: "fk_material_didatico_criado_por")

  atualizadoPorId Int?
  atualizadoPor   Usuario?  @relation("MaterialDidaticoAtualizadaPor", fields: [atualizadoPorId], references: [idUsuario], onDelete: SetNull, map: "fk_material_didatico_atualizado_por")

  @@map("materiais_didaticos")
}

model TurmaMaterialDidatico {
  idTurma     Int
  turma       Turma           @relation(fields: [idTurma], references: [idTurma], onDelete: Cascade)

  idMaterial Int
  material   MaterialDidatico @relation(fields: [idMaterial], references: [idMaterial], onDelete: Cascade)

  dataUpload DateTime         @default(now())

  @@id([idTurma, idMaterial])
  @@map("turma_material_didatico")
}

model AlunoMaterialDidatico {
  idAluno     Int
  aluno       Aluno           @relation(fields: [idAluno], references: [idUsuario], onDelete: Cascade)

  idMaterial Int
  material   MaterialDidatico @relation(fields: [idMaterial], references: [idMaterial], onDelete: Cascade)

  dataUpload DateTime         @default(now())

  @@id([idAluno, idMaterial])
  @@map("aluno_material_didatico")
}

model ConteudoInformativo {
  idConteudo  Int       @id @default(autoincrement())
  categoria   String    @db.VarChar(50)
  titulo      String    @db.VarChar(255)
  texto       String    @db.Text
  imagemUrl   String    @db.VarChar(255)

  idGestor   Int
  gestor     Gestor @relation("GestorParaConteudo", fields: [idGestor], references: [idUsuario])

  @@map("conteudos_informativos")
}

model AvisoEvento {
  idAvisoEvento Int       @id @default(autoincrement())
  titulo        String    @db.VarChar(255)
  descricao     String    @db.Text
  dataPostagem  DateTime  @default(now())
  imagemUrl     String?   @db.VarChar(255)
  ativo         Boolean   @default(true)

  idGestor   Int
  gestor     Gestor @relation("GestorParaAvisoEvento", fields: [idGestor], references: [idUsuario])

  @@map("avisos_eventos")
}